// almide/llm — LLM provider streaming clients (OpenAI-compatible, Anthropic).
//
// Each call POSTs `body_json` to the provider, hands every text fragment to
// `on_text_delta` as it arrives (for live rendering), and returns the whole
// reply as one LLM-response JSON string, the same shape for both providers:
//
//   {"content":"...","model":"...","usage":{"prompt_tokens":N,
//    "completion_tokens":N,"total_tokens":N},"finish_reason":"...",
//    "tool_calls":[{"id":"...","name":"...","arguments":"..."}]}
//
// `body_json` must already ask for a stream (`"stream": true`). A non-2xx
// status is `err("HTTP <status>: <body>")` and a transport failure is the
// err of the stdlib call handle (`could not connect to ...`). Every call
// streams through `http.start` and reads the body with `http.read_new`
// between `http.poll`s. The `_with_limits` twins pass `limits`: it bounds
// the whole call (`total_ms`) and the longest silence (`idle_ms`), 0 = no
// limit, and a fired limit is `err("request timeout: total_ms <n> exceeded")`
// / `err("request timeout: idle_ms <n> exceeded")`.
//
// Formerly `http.openai_streaming_call` & co. in the stdlib (removed at
// dialect epoch 14). The Anthropic calls gained a trailing `base_url`.
import env
import http
import self.sse
import self.openai
import self.anthropic

// POST `body` and hand every body fragment to `on_chunk` as it arrives; a
// non-2xx status is an err.
local effect fn stream(url: String, body: String, headers: List[(String, String)], limits: HttpLimits, on_chunk: (String) -> Unit) -> Result[Unit, String] = {
  let c = http.start(http.new_request("POST", url, body, headers), limits)!
  var running = true
  var outcome: Result[Unit, String] = ok(())
  while running {
    let fresh = http.read_new(c)
    if fresh != "" then on_chunk(fresh) else ()
    match http.poll(c) {
      none => env.sleep_ms(5),
      some(ok(resp)) => {
        let rest = http.read_new(c)
        if rest != "" then on_chunk(rest) else ()
        let code = http.status(resp)
        outcome = if code >= 200 and code < 300 then ok(()) else err("HTTP ${code}: ${http.body(resp)}")
        running = false
      },
      some(err(e)) => {
        outcome = err(e)
        running = false
      },
    }
  }
  outcome
}

/// Streams base_url/chat/completions; LLM-response JSON.
effect fn openai_streaming_call(base_url: String, api_key: String, body_json: String, on_text_delta: (String) -> Unit) -> String = {
  var s = sse.start()
  stream(
    openai.url(base_url),
    body_json,
    openai.headers(api_key),
    { total_ms: 0, idle_ms: 0 },
    (chunk) => {
      s = openai.feed(s, chunk, on_text_delta)
    },
  )!
  sse.final_json(s.acc)
}

/// openai_streaming_call bounded by per-call limits.
effect fn openai_streaming_call_with_limits(base_url: String, api_key: String, body_json: String, limits: HttpLimits, on_text_delta: (String) -> Unit) -> String = {
  var s = sse.start()
  stream(
    openai.url(base_url),
    body_json,
    openai.headers(api_key),
    limits,
    (chunk) => {
      s = openai.feed(s, chunk, on_text_delta)
    },
  )!
  sse.final_json(s.acc)
}

/// Streams base_url/v1/messages (Anthropic Messages); LLM-response JSON.
effect fn anthropic_streaming_call(api_key: String, body_json: String, on_text_delta: (String) -> Unit, base_url: String = "https://api.anthropic.com") -> String = {
  var s = sse.start()
  stream(
    anthropic.url(base_url),
    body_json,
    anthropic.headers(api_key),
    { total_ms: 0, idle_ms: 0 },
    (chunk) => {
      s = anthropic.feed(s, chunk, on_text_delta)
    },
  )!
  sse.final_json(s.acc)
}

/// anthropic_streaming_call bounded by per-call limits.
effect fn anthropic_streaming_call_with_limits(api_key: String, body_json: String, limits: HttpLimits, on_text_delta: (String) -> Unit, base_url: String = "https://api.anthropic.com") -> String = {
  var s = sse.start()
  stream(
    anthropic.url(base_url),
    body_json,
    anthropic.headers(api_key),
    limits,
    (chunk) => {
      s = anthropic.feed(s, chunk, on_text_delta)
    },
  )!
  sse.final_json(s.acc)
}
