// openai — the OpenAI-compatible /chat/completions SSE translation.
//
// Each payload is one `chat.completion.chunk`: `model`, an optional `usage`,
// and `choices[0]` with a `finish_reason` and a `delta` carrying text and
// `tool_calls` fragments. `data: [DONE]` ends the stream: nothing after it,
// in that chunk or a later one, is applied. A payload that is not JSON is
// skipped.
import json
import self.sse

mod fn url(base_url: String) -> String = sse.endpoint(base_url, "/chat/completions")

mod fn headers(api_key: String) -> Map[String, String] = ["Authorization": "Bearer " + api_key, "Content-Type": "application/json", "Accept": "text/event-stream"]

/// One arrival: buffer it, take every whole event block, apply their
/// payloads in order up to `[DONE]`.
mod fn feed(s: sse.Stream, chunk: String, on_delta: (String) -> Unit) -> sse.Stream =
  if s.done then s
  else {
    let (blocks, rest) = sse.split_blocks(s.buffer + chunk, [])
    let payloads = blocks |> list.map((b) => sse.data(b)) |> list.filter((p) => p != "")
    let live = payloads |> list.take_while((p) => string.trim(p) != "[DONE]")
    {
      buffer: rest,
      done: list.len(live) < list.len(payloads),
      acc: live |> list.fold(s.acc, (acc, p) => event(acc, p, on_delta)),
    }
  }

local fn event(acc: sse.Acc, payload: String, on_delta: (String) -> Unit) -> sse.Acc = match json.parse(payload) {
  err(_) => acc,
  ok(v) => {
    let named = { ...acc, model: sse.set(acc.model, json.get_string(v, "model")) }
    let counted = match value.field(v, "usage") {
      ok(u) => { ...named, prompt: sse.int_field(u, "prompt_tokens") ?? named.prompt, completion: sse.int_field(
        u,
        "completion_tokens",
      ) ?? named.completion, total: sse.int_field(u, "total_tokens") ?? named.total },
      err(_) => named,
    }
    match list.get(json.get_array(v, "choices") ?? [], 0) {
      some(first) => choice(counted, first, on_delta),
      none => counted,
    }
  },
}

local fn choice(acc: sse.Acc, c: Value, on_delta: (String) -> Unit) -> sse.Acc = {
  let finished = { ...acc, finish: sse.set(acc.finish, json.get_string(c, "finish_reason")) }
  match value.field(c, "delta") {
    err(_) => finished,
    ok(delta) => (json.get_array(delta, "tool_calls") ?? []) |> list.fold(
      sse.text(finished, json.get_string(delta, "content"), on_delta),
      (a, tc) => tool(a, tc),
    ),
  }
}

// One `tool_calls` entry: the list grows to reach the entry's index.
local fn tool(acc: sse.Acc, tc: Value) -> sse.Acc = {
  let index = sse.int_field(tc, "index") ?? 0
  let calls = sse.reach(acc.calls, index)
  let c = sse.call_at(calls, index)
  let named = { ...c, id: sse.set(c.id, json.get_string(tc, "id")) }
  let entry = match value.field(tc, "function") {
    ok(f) => { ...named, name: sse.set(named.name, json.get_string(f, "name")), arguments: named.arguments + (json.get_string(
      f,
      "arguments",
    ) ?? "") },
    err(_) => named,
  }
  { ...acc, calls: list.set(calls, index, entry) }
}
